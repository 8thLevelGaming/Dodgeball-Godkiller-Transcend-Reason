    if fight_god > game_midpoint:
        enemy_roll = random.randint(0, 100)
    elif fight_god > starting_late_game:
        enemy_roll = random.randint(25, 125)
    else:
        enemy_roll = random.randint(50, 150)

    if enemy_roll <= 10:
        new_enemy = Elite()
    elif enemy_roll <= 30:
        new_enemy = Catgirl()
    elif enemy_roll <= 50:
        new_enemy = Psychic()
    elif enemy_roll <= 80:
        new_enemy = Musha()
    elif enemy_roll <= 100:
        new_enemy = Abomination()
    elif enemy_roll <= 125:
        new_enemy = Dragon()
    elif enemy_roll <= 150:
        new_enemy = Kaiju()
    slow_print("\nA new adversary approaches!")
    return new_enemy

