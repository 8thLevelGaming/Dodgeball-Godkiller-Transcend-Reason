# Function that draws bars for a status display.
# It takes the current HP/stamina/exp value as well as the maximum values for
# those attributes (100 for exp since you always level up at 100).
# Then the program fills bars based on the current value.

# The way it works is that it uses division to determine what fraction
# of the bar should be filled and this is the scaled through width,
# then rounded to a whole number and we use the max function to
# stop the bar from bugging out if it goes negative.
def make_bar(current, maximum, width=20):
    filled = round((current / maximum) * width)
    filled = max(0, min(filled, width))
    return "[" + ("#" * filled) + ("-" * (width - filled)) + "]"

# This function is meant to display the player's level, exp, HP, and stamina.
def stats_display():
    # We use the make_bar function above to display player values as bars.
    # Note that since max HP and max Stamina are methods we need to call them
    # with () so that the program will always recalculate the maximums.
    exp_bar = make_bar(player.exp, 100, width=20)
    hp_bar = make_bar(player.hp, player.max_hp(), width=20)
    stamina_bar = make_bar(player.stamina, player.max_stamina(), width=20)
    print(f"\nLevel: {player.level} | {player.exp} / 100 {exp_bar}")
    print(f"HP: {player.hp} / {player.max_hp()} {hp_bar}") 
    print(f"Stamina: {player.stamina} / {player.max_stamina()} {stamina_bar}")

